# ==========================================
# Lost & Found India - Environment Variables
# ==========================================

# Environment & Server
NODE_ENV=development
PORT=3000

# Next.js Public Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Database (Prisma)
# Local MongoDB: mongodb://localhost:27017/lost_found_india
# MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lost_found_india?retryWrites=true&w=majority
DATABASE_URL="mongodb://localhost:27017/lost_found_india"

# NextAuth / Auth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-32-character-secret-key-change-in-production
AUTH_SECRET=your-random-32-character-secret-key-change-in-production

# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook OAuth (Meta for Developers -> Facebook Login -> Settings)
# Valid OAuth Redirect URI: http://localhost:3000/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Redis (Caching & Queue processing)
REDIS_URL=redis://localhost:6379

# S3 / MinIO Object Storage (Image uploads)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lost-found-india-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_FORCE_PATH_STYLE=true

# Security & Rate Limiting
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=60
